include("${CMAKE_CURRENT_LIST_DIR}/../phase5a/inject.cmake")
function(privacycoin_phase5b_targets)
  add_executable(privacycoin-sync-devnet "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../src/phase5b/node.cpp" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../src/phase4/ledger.cpp")
  set_target_properties(privacycoin-sync-devnet PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/phase5b")
  target_include_directories(privacycoin-sync-devnet PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../src" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../src/phase4" "${CMAKE_SOURCE_DIR}/src" "${CMAKE_SOURCE_DIR}/external/randomx/src" "${CMAKE_SOURCE_DIR}/external/db_drivers/liblmdb")
  target_link_libraries(privacycoin-sync-devnet PRIVATE cryptonote_basic ringct randomx lmdb sodium)
  add_executable(privacycoin-sync-crypto "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../src/phase5b/crypto.cpp")
  set_target_properties(privacycoin-sync-crypto PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/phase5b")
  target_include_directories(privacycoin-sync-crypto PRIVATE "${CMAKE_SOURCE_DIR}/src")
  target_link_libraries(privacycoin-sync-crypto PRIVATE cryptonote_core ringct sodium)
  add_executable(privacycoin-sync-mdb-copy "${CMAKE_SOURCE_DIR}/external/db_drivers/liblmdb/mdb_copy.c")
  target_include_directories(privacycoin-sync-mdb-copy PRIVATE "${CMAKE_SOURCE_DIR}/external/db_drivers/liblmdb")
  target_link_libraries(privacycoin-sync-mdb-copy PRIVATE lmdb)
  set_target_properties(privacycoin-sync-mdb-copy PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/phase5b")
endfunction()
cmake_language(DEFER CALL privacycoin_phase5b_targets)
