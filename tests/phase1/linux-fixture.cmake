# Linux test-only adaptation. Frozen upstream bytes and all assertions remain.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND TARGET unit_tests)
  set(original "${CMAKE_SOURCE_DIR}/tests/unit_tests/node_server.cpp")
  file(SHA256 "${original}" original_sha)
  if(NOT original_sha STREQUAL "ca4867aa58cbce6ea2b465fa924e74e3367be25cedb1684380b7426c33390eff")
    message(FATAL_ERROR "Frozen node_server fixture changed; adaptation requires review")
  endif()
  file(READ "${original}" fixture)
  string(FIND "${fixture}" "char** args = nullptr;" declaration)
  string(FIND "${fixture}" "boost::program_options::parse_command_line(0, args, opts)" invocation)
  if(declaration LESS 0 OR invocation LESS 0)
    message(FATAL_ERROR "Expected empty-command-line fixture not found")
  endif()
  string(REPLACE "char** args = nullptr;" "const char* args[] = {\"privacycoin-unit-fixture\"};" fixture "${fixture}")
  string(REPLACE "boost::program_options::parse_command_line(0, args, opts)"
    "boost::program_options::parse_command_line(1, args, opts)" fixture "${fixture}")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/linux-fixtures")
  set(generated "${CMAKE_BINARY_DIR}/linux-fixtures/node_server.cpp")
  file(WRITE "${generated}" "// Modified 2026-10-08: Linux test fixture uses valid argc/argv for Boost 1.83.\n${fixture}")
  get_target_property(original_sources unit_tests SOURCES)
  get_target_property(unit_source_dir unit_tests SOURCE_DIR)
  set(adapted_sources)
  set(replacements 0)
  foreach(source IN LISTS original_sources)
    if(source MATCHES "^\\$<")
      list(APPEND adapted_sources "${source}")
    else()
      get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${unit_source_dir}")
      if(absolute STREQUAL original)
        list(APPEND adapted_sources "${generated}")
        math(EXPR replacements "${replacements}+1")
      else()
        list(APPEND adapted_sources "${absolute}")
      endif()
    endif()
  endforeach()
  if(NOT replacements EQUAL 1)
    message(FATAL_ERROR "Expected exactly one node_server test source")
  endif()
  set_property(TARGET unit_tests PROPERTY SOURCES "${adapted_sources}")
  set_property(SOURCE "${generated}" TARGET_DIRECTORY unit_tests APPEND
    PROPERTY INCLUDE_DIRECTORIES "${unit_source_dir}")
endif()
